# Copy to backend/.env and adjust.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CSRF_TRUSTED_ORIGINS defaults to CORS_ALLOWED_ORIGINS

DB_NAME=youtube_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

REDIS_URL=redis://127.0.0.1:6379/0
# Run video processing inline instead of in a Celery worker (dev only)
CELERY_TASK_ALWAYS_EAGER=False

# Serve /media/ from Django when DEBUG=False (prefer nginx/CDN in production)
SERVE_MEDIA=False
# DJANGO_SECURE_SSL_REDIRECT=True
